# Placeholder for the future Supabase (Postgres) database.
# Not used by the app yet — it still runs on the in-memory mock data in src/lib/data.ts.
# When Supabase is ready, copy this to .env, fill in the real connection string,
# then run `npx prisma db push` (or `migrate`) against prisma/schema.prisma.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
